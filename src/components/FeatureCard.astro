---
import { Picture } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import type { FeatureText } from '../i18n/translations.types'

type Props = Readonly<{
  feature: FeatureText
  image: ImageMetadata
  widths: readonly number[]
  focus?: 'center' | 'bottom' | 'top'
}>

const { feature, image, widths, focus = 'center' } = Astro.props
---

<article class="flex flex-col gap-4">
  <Picture
    class:list={[
      'aspect-4/3 w-full rounded-card object-cover',
      focus === 'bottom' && 'object-bottom',
      focus === 'top' && 'object-top',
    ]}
    src={image}
    alt={feature.alt}
    widths={widths}
    sizes="(min-width: 768px) 360px, calc(100vw - 2rem)"
    formats={['avif', 'webp']}
    fallbackFormat="webp"
    quality={80}
    loading="lazy"
    decoding="async"
  />
  <div class="flex flex-col gap-1">
    <h3 class="text-base font-semibold text-slate-900 dark:text-ink">{feature.title}</h3>
    <p class="text-sm text-slate-500 dark:text-ink-2">{feature.description}</p>
  </div>
</article>
