---
import { Picture } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import type { FeatureText } from '../i18n/translations.types'
import NumberedPoint from './NumberedPoint.astro'

type Props = Readonly<{
  feature: FeatureText
  image: ImageMetadata
  widths: readonly number[]
  focus?: 'center' | 'bottom' | 'top'
  index: number
  revealIndex: number
  mark?: 'team' | 'code' | 'bolt' | 'layers' | 'chat' | 'cube'
}>

const { feature, image, widths, focus = 'center', index, revealIndex, mark } = Astro.props
---

<article class="flex flex-col gap-4" data-reveal style={`--reveal-index: ${revealIndex}`}>
  <Picture
    class:list={[
      'aspect-4/3 w-full rounded-card object-cover',
      focus === 'bottom' && 'object-bottom',
      focus === 'top' && 'object-top',
    ]}
    src={image}
    alt={feature.alt}
    widths={widths}
    sizes="(min-width: 768px) 360px, calc(100vw - 2rem)"
    formats={['avif', 'webp']}
    fallbackFormat="webp"
    quality={80}
    loading="lazy"
    decoding="async"
  />
  <NumberedPoint index={index} title={feature.title} description={feature.description} mark={mark} />
</article>
