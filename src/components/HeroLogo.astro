---
import { Image } from 'astro:assets'
import icon from '../assets/icon.png'
---

<div class="hero__logo">
  <svg class="hero__glow" viewBox="0 0 200 200" aria-hidden="true">
    <defs>
      <filter id="glow-blur" x="-40%" y="-40%" width="180%" height="180%">
        <feGaussianBlur stdDeviation="14"></feGaussianBlur>
      </filter>
    </defs>
    <polygon id="glow-shape" fill="#6a4cf5" fill-opacity="0.35" filter="url(#glow-blur)"></polygon>
  </svg>
  <Image class="hero__icon" src={icon} alt="" width={128} height={128} densities={[1, 2]} format="webp" loading="eager" />
</div>

<script>
  const shape = document.getElementById('glow-shape')

  const corners = [
    { x: 78, y: 36, ax: 16, ay: 12, fx: 0.55, fy: 0.35, px: 0.4, py: 1.7 },
    { x: 158, y: 52, ax: 12, ay: 18, fx: 0.4, fy: 0.62, px: 2.1, py: 0.6 },
    { x: 172, y: 128, ax: 14, ay: 14, fx: 0.7, fy: 0.42, px: 1.2, py: 2.4 },
    { x: 124, y: 176, ax: 18, ay: 10, fx: 0.33, fy: 0.58, px: 2.8, py: 1.1 },
    { x: 42, y: 162, ax: 12, ay: 16, fx: 0.48, fy: 0.36, px: 0.9, py: 2.9 },
    { x: 28, y: 78, ax: 16, ay: 12, fx: 0.62, fy: 0.5, px: 1.8, py: 0.3 },
  ]

  const draw = (time: number): void => {
    const seconds = time / 1000
    const points = corners
      .map((corner) => {
        const x = corner.x + Math.sin(seconds * corner.fx + corner.px) * corner.ax
        const y = corner.y + Math.sin(seconds * corner.fy + corner.py) * corner.ay
        return `${x.toFixed(1)},${y.toFixed(1)}`
      })
      .join(' ')
    shape?.setAttribute('points', points)
  }

  const tick = (time: number): void => {
    draw(time)
    requestAnimationFrame(tick)
  }

  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    draw(0)
  } else {
    requestAnimationFrame(tick)
  }
</script>
