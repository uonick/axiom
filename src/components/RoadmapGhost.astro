---
import RoadmapGhostControls from './roadmap-ghost/RoadmapGhostControls.astro'
import RoadmapGhostProjects from './roadmap-ghost/RoadmapGhostProjects.astro'
import RoadmapGhostRules from './roadmap-ghost/RoadmapGhostRules.astro'

type Props = Readonly<{
  kind: 'projects' | 'rules' | 'controls'
}>

const { kind } = Astro.props
---

<div class="pointer-events-none absolute inset-0" aria-hidden="true">
  <div class="absolute inset-x-4 top-12 bottom-5 flex flex-col overflow-hidden rounded-2xl bg-white shadow-xs dark:bg-surface-canvas dark:shadow-hairline-dark">
    <div class="flex h-8 shrink-0 items-center gap-1.5 px-3">
      <span class="size-2 rounded-full bg-red"></span>
      <span class="size-2 rounded-full bg-amber-400"></span>
      <span class="size-2 rounded-full bg-emerald-400"></span>
    </div>
    {kind === 'projects' && <RoadmapGhostProjects />}
    {kind === 'rules' && <RoadmapGhostRules />}
    {kind === 'controls' && <RoadmapGhostControls />}
  </div>
  <div class="absolute bottom-3 right-3 z-10 flex w-40 items-center gap-2.5 rounded-2xl bg-white p-2.5 shadow-xs dark:bg-surface-elevated dark:shadow-hairline-dark">
    <span
      class:list={[
        'flex size-8 shrink-0 items-center justify-center rounded-full text-white',
        kind === 'projects' && 'bg-emerald-500',
        kind === 'rules' && 'bg-violet-500',
        kind === 'controls' && 'bg-sky-500',
      ]}
    >
      <svg class="size-3.5" viewBox="0 0 16 16" fill="none">
        <path d="M3.5 8.5 6.5 11.5 12.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </span>
    <span class="flex min-w-0 flex-1 flex-col gap-1.5">
      <span class="h-2 w-14 rounded-full bg-slate-700 dark:bg-ink"></span>
      <span class="h-1.5 w-full rounded-full bg-slate-200 dark:bg-line-strong"></span>
      <span class="h-1.5 w-2/3 rounded-full bg-slate-200 dark:bg-line-strong"></span>
    </span>
  </div>
</div>
