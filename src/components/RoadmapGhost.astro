---
type Props = Readonly<{
  kind: 'projects' | 'rules' | 'controls'
}>

const { kind } = Astro.props
---

<div class="pointer-events-none absolute inset-3 opacity-25 dark:opacity-35" aria-hidden="true">
  <div class="flex h-full flex-col overflow-hidden rounded-lg bg-white shadow-sm dark:bg-surface-canvas dark:shadow-hairline-dark">
    <div class="flex h-7 shrink-0 items-center gap-1.5 px-2.5">
      <span class="size-2 rounded-full bg-red"></span>
      <span class="size-2 rounded-full bg-amber-400"></span>
      <span class="size-2 rounded-full bg-emerald-400"></span>
    </div>
    {kind === 'projects' && (
      <div class="flex min-h-0 flex-1 border-t border-slate-200 dark:border-line">
        <div class="flex w-2/5 flex-col gap-1.5 border-r border-slate-200 p-2 dark:border-line">
          <span class="mb-0.5 h-1.5 w-10 rounded-full bg-slate-300 dark:bg-ink-3"></span>
          <span class="flex h-5 items-center gap-1.5 rounded-md bg-slate-200 px-1.5 dark:bg-surface-hover">
            <span class="size-3 shrink-0 rounded-sm bg-slate-400 dark:bg-ink-3"></span>
            <span class="h-1.5 min-w-0 flex-1 rounded-full bg-slate-400 dark:bg-ink-3"></span>
          </span>
          <span class="flex h-5 items-center gap-1.5 px-1.5">
            <span class="size-3 shrink-0 rounded-sm bg-slate-300 dark:bg-line-strong"></span>
            <span class="h-1.5 w-3/4 rounded-full bg-slate-300 dark:bg-line-strong"></span>
          </span>
          <span class="flex h-5 items-center gap-1.5 px-1.5">
            <span class="size-3 shrink-0 rounded-sm bg-slate-300 dark:bg-line-strong"></span>
            <span class="h-1.5 w-2/3 rounded-full bg-slate-300 dark:bg-line-strong"></span>
          </span>
          <span class="flex h-5 items-center gap-1.5 px-1.5">
            <span class="size-3 shrink-0 rounded-sm bg-slate-300 dark:bg-line-strong"></span>
            <span class="h-1.5 w-4/5 rounded-full bg-slate-300 dark:bg-line-strong"></span>
          </span>
        </div>
        <div class="flex min-w-0 flex-1 flex-col gap-2 p-2.5">
          <span class="h-2 w-1/2 rounded-full bg-slate-300 dark:bg-ink-3"></span>
          <span class="h-1.5 w-full rounded-full bg-slate-200 dark:bg-surface-field"></span>
          <span class="h-1.5 w-4/5 rounded-full bg-slate-200 dark:bg-surface-field"></span>
          <span class="h-1.5 w-2/3 rounded-full bg-slate-200 dark:bg-surface-field"></span>
          <span class="mt-auto flex gap-1.5">
            <span class="h-5 w-12 rounded-full bg-slate-300 dark:bg-surface-field"></span>
            <span class="h-5 w-8 rounded-full bg-slate-800 dark:bg-ink"></span>
          </span>
        </div>
      </div>
    )}
    {kind === 'rules' && (
      <div class="flex min-h-0 flex-1 flex-col gap-2 border-t border-slate-200 p-2.5 dark:border-line">
        <div class="flex gap-1.5">
          <span class="h-5 w-14 rounded-full bg-slate-200 dark:bg-surface-field"></span>
          <span class="h-5 w-10 rounded-full bg-slate-200 dark:bg-surface-field"></span>
          <span class="h-5 w-12 rounded-full bg-slate-200 dark:bg-surface-field"></span>
        </div>
        <span class="flex h-6 items-center justify-between rounded-md bg-slate-100 px-2 dark:bg-surface-hover">
          <span class="h-1.5 w-1/2 rounded-full bg-slate-300 dark:bg-ink-3"></span>
          <span class="h-3 w-5 rounded-full bg-slate-400 dark:bg-ink-3"></span>
        </span>
        <span class="flex h-6 items-center justify-between rounded-md px-2">
          <span class="h-1.5 w-2/5 rounded-full bg-slate-300 dark:bg-line-strong"></span>
          <span class="h-3 w-5 rounded-full bg-slate-300 dark:bg-line-strong"></span>
        </span>
        <span class="flex h-6 items-center justify-between rounded-md px-2">
          <span class="h-1.5 w-1/2 rounded-full bg-slate-300 dark:bg-line-strong"></span>
          <span class="h-3 w-5 rounded-full bg-slate-300 dark:bg-line-strong"></span>
        </span>
        <span class="flex h-6 items-center justify-between rounded-md px-2">
          <span class="h-1.5 w-1/3 rounded-full bg-slate-300 dark:bg-line-strong"></span>
          <span class="h-3 w-5 rounded-full bg-slate-300 dark:bg-line-strong"></span>
        </span>
      </div>
    )}
    {kind === 'controls' && (
      <div class="flex min-h-0 flex-1 flex-col gap-2.5 border-t border-slate-200 p-2.5 dark:border-line">
        <span class="flex flex-col gap-1">
          <span class="h-1.5 w-14 rounded-full bg-slate-300 dark:bg-ink-3"></span>
          <span class="h-1.5 overflow-hidden rounded-full bg-slate-200 dark:bg-surface-field">
            <span class="block h-full w-2/3 rounded-full bg-slate-400 dark:bg-ink-3"></span>
          </span>
        </span>
        <span class="flex flex-col gap-1">
          <span class="h-1.5 w-10 rounded-full bg-slate-300 dark:bg-ink-3"></span>
          <span class="h-1.5 overflow-hidden rounded-full bg-slate-200 dark:bg-surface-field">
            <span class="block h-full w-1/2 rounded-full bg-slate-400 dark:bg-ink-3"></span>
          </span>
        </span>
        <span class="flex flex-col gap-1">
          <span class="h-1.5 w-16 rounded-full bg-slate-300 dark:bg-ink-3"></span>
          <span class="h-1.5 overflow-hidden rounded-full bg-slate-200 dark:bg-surface-field">
            <span class="block h-full w-4/5 rounded-full bg-slate-400 dark:bg-ink-3"></span>
          </span>
        </span>
        <span class="mt-auto flex gap-1.5">
          <span class="h-6 min-w-0 flex-1 rounded-md bg-slate-200 dark:bg-surface-field"></span>
          <span class="h-6 min-w-0 flex-1 rounded-md bg-slate-200 dark:bg-surface-field"></span>
          <span class="h-6 w-14 rounded-full bg-slate-800 dark:bg-ink"></span>
        </span>
      </div>
    )}
  </div>
</div>
