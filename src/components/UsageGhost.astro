---
import UsageGhostCorporate from './usage-ghost/UsageGhostCorporate.astro'
import UsageGhostFree from './usage-ghost/UsageGhostFree.astro'
import UsageGhostKeys from './usage-ghost/UsageGhostKeys.astro'
import UsageGhostSubscription from './usage-ghost/UsageGhostSubscription.astro'

type Props = Readonly<{
  kind: 'free' | 'subscription' | 'keys' | 'corporate'
}>

const { kind } = Astro.props
---

<div class="pointer-events-none absolute inset-0" aria-hidden="true">
  {kind === 'free' && <UsageGhostFree />}
  {kind === 'subscription' && <UsageGhostSubscription />}
  {kind === 'keys' && <UsageGhostKeys />}
  {kind === 'corporate' && <UsageGhostCorporate />}
</div>
