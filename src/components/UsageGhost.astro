---
type Props = Readonly<{
  kind: 'free' | 'subscription' | 'keys' | 'corporate'
}>

const { kind } = Astro.props
---

<div class="pointer-events-none absolute inset-0" aria-hidden="true">
  {kind === 'free' && (
    <>
      <div class="absolute inset-x-4 top-12 bottom-5 flex flex-col overflow-hidden rounded-2xl bg-white shadow-xs dark:bg-surface-canvas dark:shadow-hairline-dark">
        <div class="flex h-8 shrink-0 items-center gap-1.5 px-3">
          <span class="size-2 rounded-full bg-red"></span>
          <span class="size-2 rounded-full bg-amber-400"></span>
          <span class="size-2 rounded-full bg-emerald-400"></span>
        </div>
        <div class="flex min-h-0 flex-1 flex-col gap-1.5 border-t border-emerald-100 p-2.5 dark:border-line">
          <span class="flex h-6 items-center gap-2 rounded-md bg-emerald-50 px-2 dark:bg-emerald-400/15">
            <span class="size-3 shrink-0 rounded-sm bg-emerald-400"></span>
            <span class="h-1.5 w-1/2 rounded-full bg-emerald-300"></span>
          </span>
          <span class="flex h-6 items-center gap-2 px-2">
            <span class="size-3 shrink-0 rounded-sm bg-sky-300"></span>
            <span class="h-1.5 w-2/5 rounded-full bg-slate-200 dark:bg-line-strong"></span>
          </span>
          <span class="flex h-6 items-center gap-2 px-2">
            <span class="size-3 shrink-0 rounded-sm bg-violet-300"></span>
            <span class="h-1.5 w-1/3 rounded-full bg-slate-200 dark:bg-line-strong"></span>
          </span>
        </div>
      </div>
      <span class="absolute bottom-3 right-3 z-10 inline-flex h-8 items-center gap-1.5 rounded-full bg-white px-3 text-xs font-semibold text-emerald-600 shadow-xs dark:bg-surface-elevated dark:text-emerald-200 dark:shadow-hairline-dark">
        <span class="size-2 rounded-full bg-emerald-500"></span>
        Free
      </span>
    </>
  )}
  {kind === 'subscription' && (
    <>
      <div class="absolute left-1/2 top-1/2 flex size-20 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-3xl bg-white text-violet-500 shadow-xs dark:bg-surface-elevated dark:text-violet-200 dark:shadow-hairline-dark">
        <svg class="size-9" viewBox="0 0 24 24" fill="none">
          <path d="m3 8 4.5 4L12 5l4.5 7L21 8l-2 11H5L3 8Z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"></path>
        </svg>
      </div>
      <span class="absolute left-6 top-14 size-9 rounded-xl bg-emerald-400/80 shadow-xs"></span>
      <span class="absolute right-7 top-12 size-8 rounded-xl bg-amber-400/80 shadow-xs"></span>
      <span class="absolute bottom-8 left-9 size-8 rounded-xl bg-sky-400/80 shadow-xs"></span>
      <span class="absolute bottom-7 right-8 size-10 rounded-xl bg-rose-400/80 shadow-xs"></span>
    </>
  )}
  {kind === 'keys' && (
    <>
      <div class="absolute inset-x-4 top-12 bottom-5 flex flex-col gap-2 rounded-2xl bg-white p-3 shadow-xs dark:bg-surface-canvas dark:shadow-hairline-dark">
        <span class="flex h-7 items-center gap-2 rounded-md bg-amber-50 px-2 dark:bg-amber-400/15">
          <span class="size-3.5 shrink-0 rounded-full bg-amber-400"></span>
          <span class="flex gap-1">
            <span class="size-1.5 rounded-full bg-amber-500"></span>
            <span class="size-1.5 rounded-full bg-amber-500"></span>
            <span class="size-1.5 rounded-full bg-amber-500"></span>
            <span class="size-1.5 rounded-full bg-amber-500"></span>
            <span class="size-1.5 rounded-full bg-amber-500"></span>
          </span>
        </span>
        <span class="flex h-7 items-center gap-2 rounded-md bg-violet-50 px-2 dark:bg-violet-400/15">
          <span class="size-3.5 shrink-0 rounded-full bg-violet-400"></span>
          <span class="flex gap-1">
            <span class="size-1.5 rounded-full bg-violet-500"></span>
            <span class="size-1.5 rounded-full bg-violet-500"></span>
            <span class="size-1.5 rounded-full bg-violet-500"></span>
            <span class="size-1.5 rounded-full bg-violet-500"></span>
          </span>
        </span>
      </div>
      <span class="absolute bottom-3 right-3 z-10 flex size-10 items-center justify-center rounded-full bg-amber-500 text-white shadow-xs">
        <svg class="size-4" viewBox="0 0 24 24" fill="none">
          <circle cx="8" cy="15" r="4" stroke="currentColor" stroke-width="2"></circle>
          <path d="m11 12 9-9M16 7l3 3" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
        </svg>
      </span>
    </>
  )}
  {kind === 'corporate' && (
    <>
      <div class="absolute inset-x-4 top-12 bottom-5 flex flex-col gap-1.5 rounded-2xl bg-white p-2.5 shadow-xs dark:bg-surface-canvas dark:shadow-hairline-dark">
        <span class="flex h-7 items-center gap-2 px-1">
          <span class="size-4 shrink-0 rounded-full bg-sky-300"></span>
          <span class="h-1.5 w-1/3 rounded-full bg-slate-200 dark:bg-line-strong"></span>
          <span class="ml-auto h-3 w-6 rounded-full bg-sky-400"></span>
        </span>
        <span class="flex h-7 items-center gap-2 rounded-md bg-sky-50 px-1 dark:bg-sky-400/15">
          <span class="size-4 shrink-0 rounded-full bg-violet-300"></span>
          <span class="h-1.5 w-2/5 rounded-full bg-sky-300"></span>
          <span class="ml-auto h-3 w-6 rounded-full bg-sky-400"></span>
        </span>
        <span class="flex h-7 items-center gap-2 px-1">
          <span class="size-4 shrink-0 rounded-full bg-emerald-300"></span>
          <span class="h-1.5 w-1/4 rounded-full bg-slate-200 dark:bg-line-strong"></span>
          <span class="ml-auto h-3 w-6 rounded-full bg-slate-200 dark:bg-line-strong"></span>
        </span>
      </div>
      <span class="absolute bottom-3 right-3 z-10 flex size-10 items-center justify-center rounded-full bg-sky-500 text-white shadow-xs">
        <svg class="size-4" viewBox="0 0 24 24" fill="none">
          <path d="M12 3 4 6v6c0 4.5 3.2 7.8 8 9 4.8-1.2 8-4.5 8-9V6l-8-3Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path>
          <path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </span>
    </>
  )}
</div>
