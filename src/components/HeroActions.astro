---
import { siteConfig } from '../site.config'
import { translations } from '../i18n/translations'
import HeroButton from './HeroButton.astro'
import AppleIcon from './icons/AppleIcon.astro'
import LinuxIcon from './icons/LinuxIcon.astro'
import WindowsIcon from './icons/WindowsIcon.astro'
import GithubIcon from './icons/GithubIcon.astro'

const text = translations.en
const russian = translations.ru
---

<div class="hero__actions">
  <HeroButton href={siteConfig.latestReleaseUrl} label={text.download} russianLabel={russian.download} download>
    <span data-platform-icon="mac"><AppleIcon /></span>
    <span data-platform-icon="windows"><WindowsIcon /></span>
    <span data-platform-icon="linux"><LinuxIcon /></span>
  </HeroButton>
  <HeroButton href={siteConfig.releasesUrl} label={text.github}>
    <GithubIcon />
  </HeroButton>
</div>
