---
import { Image } from 'astro:assets'
import { getRelativeLocaleUrl } from 'astro:i18n'
import icon from '../assets/icon.png'
import { siteConfig } from '../site.config'
import { resolveLocale, translationFor } from '../i18n/translations'

const locale = resolveLocale(Astro.currentLocale)
const text = translationFor(locale)

const columns = [
  {
    key: 'product',
    links: [
      { key: 'releases', href: siteConfig.releasesUrl },
      { key: 'source', href: siteConfig.repositoryUrl },
    ],
  },
  {
    key: 'resources',
    links: [{ key: 'issues', href: `${siteConfig.repositoryUrl}/issues` }],
  },
  {
    key: 'legal',
    links: [{ key: 'license', href: `${siteConfig.repositoryUrl}#readme` }],
  },
] as const

const year = new Date().getFullYear()
---

<footer class="below-fold border-t border-slate-200 dark:border-line">
  <div class="mx-auto flex max-w-6xl flex-col gap-10 px-4 py-12 sm:px-6 md:flex-row md:items-start md:justify-between">
    <a class="flex min-h-11 items-center gap-2 font-mono" href={getRelativeLocaleUrl(locale, '')} aria-label={siteConfig.name}>
      <Image class="size-7" src={icon} alt="" width={28} height={28} densities={[1, 2]} format="webp" />
      <span class="text-base font-semibold text-slate-900 dark:text-ink">{siteConfig.name}</span>
    </a>
    <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 md:gap-16">
      {
        columns.map((column) => (
          <div class="flex flex-col gap-1">
            <p class="text-sm font-medium text-slate-900 md:flex md:min-h-11 md:items-center dark:text-ink">
              {text.footerGroups[column.key]}
            </p>
            {column.links.map((link) => (
              <a
                class="inline-flex min-h-11 items-center text-sm text-slate-500 transition-colors duration-150 hover:text-slate-900 dark:text-ink-2 dark:hover:text-ink"
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                {text.footerLinks[link.key]}
              </a>
            ))}
          </div>
        ))
      }
    </div>
  </div>
  <div class="mx-auto max-w-6xl px-4 pb-8 font-mono text-xs text-slate-400 sm:px-6 dark:text-ink-3">
    © {year} {siteConfig.name}. {text.footerRights}
  </div>
</footer>
