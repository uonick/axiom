---
import projectsShot from '../assets/screens/projects-chats.png'
import gitShot from '../assets/screens/git.png'
import pipelinesShot from '../assets/screens/pipelines.png'
import { translationFor } from '../i18n/translations'
import FeatureCard from './FeatureCard.astro'

const text = translationFor(Astro.currentLocale)
const shots = [
  { src: projectsShot, text: text.screens[0], widths: [480, 768, 1004], focus: 'top' },
  { src: gitShot, text: text.screens[1], widths: [480, 768, 1100], focus: 'center' },
  { src: pipelinesShot, text: text.screens[2], widths: [480, 768, 1246], focus: 'top' },
] as const
---

<section class="below-fold mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
  <div class="grid gap-10 md:grid-cols-3">
    {shots.map((shot, index) => (
      <FeatureCard feature={shot.text} image={shot.src} widths={shot.widths} focus={shot.focus} revealIndex={index} />
    ))}
  </div>
</section>
