---
import { providerNames, type ProviderKey } from '../site.config'
import local from '../assets/providers/local.svg'
import custom from '../assets/providers/custom.svg'

type Props = Readonly<{ name: ProviderKey }>

type ProviderTone = 'orange' | 'green' | 'purple' | 'teal' | 'blue'

const { name } = Astro.props

const providerTones: Readonly<Record<ProviderKey, ProviderTone>> = {
  anthropic: 'orange',
  openai: 'green',
  grok: 'blue',
  google: 'teal',
  qwen: 'purple',
  deepseek: 'blue',
  openrouter: 'purple',
  ollama: 'teal',
  local: 'green',
  custom: 'orange',
}

const providerGlyphs: Readonly<Record<ProviderKey, typeof local | null>> = {
  anthropic: null,
  openai: null,
  grok: null,
  google: null,
  qwen: null,
  deepseek: null,
  openrouter: null,
  ollama: null,
  local,
  custom,
}

const tone = providerTones[name]
const Glyph = providerGlyphs[name]
---

<span
  class:list={[
    'flex size-8 shrink-0 items-center justify-center rounded-control font-mono text-sm font-semibold',
    {
      'bg-tone-orange-tint text-tone-orange': tone === 'orange',
      'bg-tone-green-tint text-tone-green': tone === 'green',
      'bg-tone-purple-tint text-tone-purple': tone === 'purple',
      'bg-tone-teal-tint text-tone-teal': tone === 'teal',
      'bg-tone-blue-tint text-tone-blue': tone === 'blue',
    },
  ]}
  aria-hidden="true"
>
  {Glyph ? <Glyph class="size-4" /> : providerNames[name].charAt(0)}
</span>
