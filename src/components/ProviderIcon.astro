---
import type { ProviderKey } from '../site.config'
import anthropic from '../assets/providers/anthropic.svg'
import openai from '../assets/providers/openai.svg'
import grok from '../assets/providers/grok.svg'
import google from '../assets/providers/google.svg'
import qwen from '../assets/providers/qwen.svg'
import deepseek from '../assets/providers/deepseek.svg'
import openrouter from '../assets/providers/openrouter.svg'
import ollama from '../assets/providers/ollama.svg'
import local from '../assets/providers/local.svg'
import custom from '../assets/providers/custom.svg'

type Props = Readonly<{ name: ProviderKey }>

const { name } = Astro.props

const icons = {
  anthropic,
  openai,
  grok,
  google,
  qwen,
  deepseek,
  openrouter,
  ollama,
  local,
  custom,
} satisfies Record<ProviderKey, typeof anthropic>

const Icon = icons[name]
---

<Icon class="size-6 shrink-0" aria-hidden="true" />
