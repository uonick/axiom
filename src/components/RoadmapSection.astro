---
import { translationFor } from '../i18n/translations'
import RoadmapCard from './RoadmapCard.astro'

const text = translationFor(Astro.currentLocale)
const cards = [
  { kind: 'projects', mark: 'team' },
  { kind: 'rules', mark: 'spark' },
  { kind: 'controls', mark: 'sliders' },
] as const
---

<section class="below-fold mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
  <h2 class="inline-flex items-center rounded-full bg-indigo-100 px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wide text-indigo-500 dark:bg-indigo-400/20 dark:text-indigo-200" data-reveal style="--reveal-index: 0">
    {text.roadmapTitle}
  </h2>
  <div class="mt-10 grid gap-10 md:grid-cols-3">
    {text.roadmap.map((item, index) => {
      const card = cards[index]
      if (card === undefined) return null
      return <RoadmapCard item={item} badge={text.roadmapBadge} kind={card.kind} mark={card.mark} index={index} revealIndex={index + 1} />
    })}
  </div>
</section>
