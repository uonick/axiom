---
import { siteConfig } from '../site.config'
import { translationFor } from '../i18n/translations'
import Button from './Button.astro'
import GithubIcon from './icons/GithubIcon.astro'
import PlatformIcons from './icons/PlatformIcons.astro'

const text = translationFor(Astro.currentLocale)
---

<section class="below-fold mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-20">
  <div
    class="cta-panel flex flex-col items-center rounded-card bg-slate-900 px-6 py-16 text-center sm:py-20 dark:bg-ink"
    data-reveal
    style="--reveal-index: 0"
  >
    <h2 class="max-w-2xl font-mono text-2xl font-semibold text-white sm:text-4xl dark:text-surface-page">
      {text.ctaTitle}
    </h2>
    <p class="mt-4 max-w-xl text-base text-white/70 sm:text-lg dark:text-surface-page/70">{text.ctaSubtitle}</p>
    <div class="mt-8 flex w-full flex-col justify-center gap-3 sm:w-auto sm:flex-row">
      <Button href={siteConfig.latestReleaseUrl} label={text.download} badge={text.betaBadge} variant="primary" tone="inverted" size="lg" download>
        <PlatformIcons />
      </Button>
      <Button href={siteConfig.releasesUrl} label={text.github} variant="secondary" tone="inverted">
        <GithubIcon />
      </Button>
    </div>
  </div>
</section>
