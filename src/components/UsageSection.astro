---
import { translationFor } from '../i18n/translations'
import UsageCard from './UsageCard.astro'

const text = translationFor(Astro.currentLocale)
const cards = [
  { kind: 'free', mark: 'code' },
  { kind: 'keys', mark: 'bolt' },
  { kind: 'corporate', mark: 'team' },
  { kind: 'subscription', mark: 'spark' },
] as const
---

<section class="below-fold mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
  <p class="inline-flex items-center gap-1 rounded-full bg-indigo-100 px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wide text-indigo-500 dark:bg-indigo-400/20 dark:text-indigo-200" data-reveal style="--reveal-index: 0">
    <svg class="size-3" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
      <path d="M8 .4 10.1 5.9 15.6 8 10.1 10.1 8 15.6 5.9 10.1.4 8 5.9 5.9 8 .4Z"></path>
    </svg>
    {text.usageEyebrow}
  </p>
  <h2 class="mt-4 max-w-2xl font-mono text-2xl font-semibold text-slate-900 sm:text-3xl dark:text-ink" data-reveal style="--reveal-index: 1">
    {text.usageTitle}
  </h2>
  <p class="mt-3 max-w-2xl text-base text-slate-500 dark:text-ink-2" data-reveal style="--reveal-index: 2">
    {text.usageSubtitle}
  </p>
  <div class="mt-10 grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
    {text.usage.map((item, index) => {
      const card = cards[index]
      if (card === undefined) return null
      return <UsageCard item={item} kind={card.kind} mark={card.mark} index={index} badge={card.kind === 'corporate' || card.kind === 'subscription' ? text.usageSoonBadge : undefined} revealIndex={index + 3} />
    })}
  </div>
</section>
