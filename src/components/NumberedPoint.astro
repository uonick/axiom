---
import NumberedPointBolt from './numbered-point/NumberedPointBolt.astro'
import NumberedPointChat from './numbered-point/NumberedPointChat.astro'
import NumberedPointCode from './numbered-point/NumberedPointCode.astro'
import NumberedPointCube from './numbered-point/NumberedPointCube.astro'
import NumberedPointFolder from './numbered-point/NumberedPointFolder.astro'
import NumberedPointLayers from './numbered-point/NumberedPointLayers.astro'
import NumberedPointSliders from './numbered-point/NumberedPointSliders.astro'
import NumberedPointSpark from './numbered-point/NumberedPointSpark.astro'
import NumberedPointTeam from './numbered-point/NumberedPointTeam.astro'

type Mark = 'team' | 'code' | 'bolt' | 'spark' | 'sliders' | 'layers' | 'chat' | 'cube' | 'folder'

type Props = Readonly<{
  index: number
  title: string
  description: string
  mark?: Mark
}>

const marks = {
  folder: NumberedPointFolder,
  team: NumberedPointTeam,
  code: NumberedPointCode,
  bolt: NumberedPointBolt,
  spark: NumberedPointSpark,
  sliders: NumberedPointSliders,
  layers: NumberedPointLayers,
  chat: NumberedPointChat,
  cube: NumberedPointCube,
} satisfies Record<Mark, typeof NumberedPointFolder>

const { index, title, description, mark } = Astro.props
const label = String(index + 1).padStart(2, '0')
const tone = index % 4
const MarkIcon = mark === undefined ? undefined : marks[mark]
---

<div class="flex items-start gap-2.5">
  <span
    class:list={[
      'flex size-7 shrink-0 items-center justify-center rounded-full text-xs font-semibold leading-none tabular-nums',
      tone === 0 && 'bg-violet-100 text-violet-600 dark:bg-violet-400/20 dark:text-violet-200',
      tone === 1 && 'bg-sky-100 text-sky-600 dark:bg-sky-400/20 dark:text-sky-200',
      tone === 2 && 'bg-rose-100 text-rose-600 dark:bg-rose-400/20 dark:text-rose-200',
      tone === 3 && 'bg-amber-100 text-amber-600 dark:bg-amber-400/20 dark:text-amber-200',
    ]}
    aria-hidden="true"
  >
    {MarkIcon !== undefined && <MarkIcon />}
    {mark === undefined && label}
  </span>
  <div class="flex min-w-0 flex-col gap-1">
    <h3 class="text-base font-semibold text-slate-900 dark:text-ink">{title}</h3>
    <p class="max-w-2xl text-sm text-slate-500 dark:text-ink-2">{description}</p>
  </div>
</div>
