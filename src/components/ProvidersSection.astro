---
import { providerKeys } from '../site.config'
import { translationFor } from '../i18n/translations'
import ProviderItem from './ProviderItem.astro'

const text = translationFor(Astro.currentLocale)
---

<section class="below-fold mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
  <h2 class="max-w-2xl text-2xl font-semibold tracking-tight text-slate-900 sm:text-3xl dark:text-ink">
    {text.providersTitle}
  </h2>
  <p class="mt-3 max-w-2xl text-base text-slate-500 dark:text-ink-2">
    {text.providersSubtitle}
  </p>
  <ul class="mt-10 grid grid-cols-2 gap-x-4 gap-y-8 md:grid-cols-3 lg:grid-cols-5">
    {providerKeys.map((key) => <ProviderItem name={key} caption={text.providerCaptions[key]} />)}
  </ul>
</section>
