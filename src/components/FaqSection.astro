---
import { translationFor } from '../i18n/translations'
import NumberedPoint from './NumberedPoint.astro'

const text = translationFor(Astro.currentLocale)
---

<section class="below-fold mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
  <h2 class="max-w-2xl text-2xl font-semibold tracking-tight text-slate-900 sm:text-3xl dark:text-ink" data-reveal style="--reveal-index: 0">
    {text.faqTitle}
  </h2>
  <div class="mt-8 flex max-w-3xl flex-col">
    {
      text.faq.map((item, index) => (
        <div class="border-t border-slate-200 py-5 dark:border-line" data-reveal style={`--reveal-index: ${index + 1}`}>
          <NumberedPoint index={index} title={item.question} description={item.answer} />
        </div>
      ))
    }
  </div>
</section>
