---
import { getImage } from 'astro:assets'
import screenshot from '../assets/screenshot.png'
import '../styles/global.css'
import { translations } from '../i18n/translations'
import { buildStructuredData } from '../lib/structured-data'

const text = translations.en
const russian = translations.ru
const siteUrl = Astro.site?.origin ?? ''
const canonicalUrl = `${siteUrl}/`
const openGraphImage = await getImage({ src: screenshot, width: 1200, format: 'jpg', quality: 85 })
const openGraphImageUrl = new URL(openGraphImage.src, siteUrl).href
const openGraphImageHeight = openGraphImage.attributes.height

const structuredData = buildStructuredData({ siteUrl, canonicalUrl, imageUrl: openGraphImageUrl, text })
---

<!doctype html>
<html lang={text.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#090909" />
    <meta name="color-scheme" content="dark" />
    <meta name="format-detection" content="telephone=no" />
    <title data-ru={russian.title}>{text.title}</title>
    <meta name="description" content={text.description} data-ru={russian.description} />
    <meta name="keywords" content={text.keywords} data-ru={russian.keywords} />
    <meta name="author" content="Axiom" />
    <meta name="application-name" content="Axiom" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/favicon-32.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Axiom" />
    <meta property="og:title" content={text.title} data-ru={russian.title} />
    <meta property="og:description" content={text.description} data-ru={russian.description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={text.ogLocale} />
    <meta property="og:locale:alternate" content={russian.ogLocale} />
    <meta property="og:image" content={openGraphImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content={String(openGraphImageHeight)} />
    <meta property="og:image:alt" content={text.ogImageAlt} data-ru={russian.ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={text.title} data-ru={russian.title} />
    <meta name="twitter:description" content={text.description} data-ru={russian.description} />
    <meta name="twitter:image" content={openGraphImageUrl} />
    <meta name="twitter:image:alt" content={text.ogImageAlt} data-ru={russian.ogImageAlt} />

    <meta name="apple-mobile-web-app-title" content="Axiom" />
    <meta name="mobile-web-app-capable" content="yes" />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <slot />
    <script>
      import '../lib/apply-browser-language'
    </script>
  </body>
</html>
